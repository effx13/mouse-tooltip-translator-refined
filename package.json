{
  "name": "mouse-tooltip-translator-refined",
  "version": "0.1.89",
  "private": true,
  "description": "Hover or select text to translate it in a tooltip",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv2",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv2",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv2",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "test:e2e": "wxt build && playwright test",
    "screenshots": "wxt build && node scripts/screenshots.ts",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@lucide/svelte": "^1.66.0",
    "@noble/hashes": "^2.4.0",
    "@webext-core/messaging": "^4.0.1",
    "bits-ui": "^2.20.3",
    "clsx": "^2.1.1",
    "entities": "^9.0.0",
    "es-toolkit": "^1.53.1",
    "foliate-js": "^1.0.1",
    "ky": "^1.0.1",
    "node-html-parser": "^9.0.6",
    "pdfjs-dist": "^6.5.438",
    "svelte-sonner": "^1.2.2",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@wxt-dev/auto-icons": "^1.1.2",
    "@wxt-dev/module-svelte": "^2.0.5",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "playwright": "^1.64.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.4.1"
}
