{
  "name": "mouse_tooltip_translator",
  "version": "0.1.89",
  "private": true,
  "description": "Mouse over to translate",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv2",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv2",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv2",
    "postinstall": "wxt prepare",
    "test": "vitest run",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@noble/hashes": "^2.4.0",
    "@webext-core/messaging": "^4.0.1",
    "entities": "^9.0.0",
    "es-toolkit": "^1.53.1",
    "ky": "^1.0.1",
    "node-html-parser": "^9.0.6"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@wxt-dev/auto-icons": "^1.1.2",
    "@wxt-dev/module-svelte": "^2.0.5",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.4.1"
}
