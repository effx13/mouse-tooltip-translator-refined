{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noImplicitAny": false,
    "types": ["chrome", "node", "vite/client", "vitest/globals"],
    "baseUrl": ".",
    "paths": { "/src/*": ["./src/*"] }
  },
  "include": ["src", "__tests__", "scripts", "vite.config.ts"],
  "exclude": ["build", "public", "node_modules"]
}
